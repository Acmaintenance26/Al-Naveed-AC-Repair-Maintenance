# Copy this file to .env.local and fill in what you need. Never commit .env.local.

# --- Site -------------------------------------------------------------------
# Public address of the site, no trailing slash. Used for canonical URLs, the sitemap
# and structured data.
NEXT_PUBLIC_SITE_URL=https://www.alnaveedac.com

# --- Enquiry and booking forms ------------------------------------------------
# Choose ONE delivery method. With none set, the forms tell visitors to call or use
# WhatsApp instead and never claim the request was sent.

# Option A: send each submission as JSON to a webhook (Zapier, Make, n8n, a CRM).
ENQUIRY_WEBHOOK_URL=

# Option B: email each submission through Resend (https://resend.com).
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=
# Must be an address on a domain verified in Resend.
ENQUIRY_FROM_EMAIL=

# Development only: accept submissions and print a masked line to the terminal.
# Ignored in production.
ENQUIRY_DELIVERY=

# --- AI assistant -------------------------------------------------------------
# Optional. Without a key the assistant answers from its built-in guide.
# Server-side only: never prefix this with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
# Optional model override. Defaults to claude-opus-5-5.
ANTHROPIC_MODEL=

# --- Blog ---------------------------------------------------------------------
# Set to true to preview draft articles locally. Leave unset in production.
SHOW_DRAFT_POSTS=
